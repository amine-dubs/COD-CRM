# ML Service Configuration

# Server
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001

# MySQL Database (same as PHP backend)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cod_crm
DB_USER=root
DB_PASSWORD=

# Google Gemini API (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# API Authentication (generate a secure random key for production)
ML_API_KEY=

# Model paths
MODEL_DIR=./trained_models

# Data paths
DATA_DIR=./data/olist

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
