# ===========================
# COD CRM Backend Environment
# ===========================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control!

# App
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cod_crm
DB_USERNAME=root
DB_PASSWORD=

# JWT (IMPORTANT: Generate a strong random secret for production!)
# Use: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-CHANGE-THIS-IN-PRODUCTION
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://*.localhost:3000

# File Storage
STORAGE_PATH=storage
MAX_UPLOAD_SIZE=10485760

# ML Service
ML_SERVICE_URL=http://localhost:8001
