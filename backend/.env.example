# ===========================
# COD CRM Backend Environment
# ===========================

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cod_crm
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://*.localhost:3000

# File Storage
STORAGE_PATH=storage
MAX_UPLOAD_SIZE=10485760
